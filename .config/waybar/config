{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 8,
  "margin-left": 25,
  "margin-right": 25,

  "modules-left": [
    "custom/arch",
   // "hyprland/window",
    "custom/iltiss",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "tray",
    "disk",
    "memory",
    "cpu",
    "custom/notification",
    "network",
    "pulseaudio",
    "battery",
    "custom/power"
  ],

  "custom/arch": {
    "format": "",
    "on-click": "rofi -show drun",
    "tooltip": false
  },

  "clock": {
    "format": "󰥔 {:%H:%M}"
  },

  "custom/iltiss": {
    "format": "ILTISS | I like that it's so simple",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "active": ""
    },
    "on-click": "activate",
    "all-outputs": true,
    "persistent-workspaces": {
      "1": [],
      "2": []
    }
  },

  "hyprland": {
    "format": "{}",
    "max-length": 60,
    "separate-outputs": true
  },

  "tray": {
    "icon-size": 18,
    "spacing": 10
  },

  "temperature": {
    "interval": 2,
    "format": " {temperatureC}°C",
    "critical-threshold": 80,
    "tooltip": true
  },

  "disk": {
    "interval": 30,
    "path": "/",
    "format": " {percentage_used}%",
    "tooltip": true
  },

  "memory": {
    "interval": 2,
    "format": " {percentage}%",
    "tooltip": true
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip": true
  },

  "custom/notification": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󰵙",
      "none": "󰂚",
      "dnd-notification": "󰂛 󰵙",
      "dnd-none": "󰂛"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "network": {
    "interval": 3,
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "󰛳",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 mute",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "tooltip-format": "{desc}"
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
  },

  "custom/power": {
    "format": "",
    "on-click": "~/.config/rofi/scripts/powermenu.sh",
    "tooltip": false
  }
}
